            </a>
          </li>
          <li>
            <a href="/privacy-policy" class="text-slate-400 hover:text-emerald-400 transition-colors">
              Privacy Policy (DPDP 2023)
            </a>
          </li>
          <li>
            <a href="/terms-of-service" class="text-slate-400 hover:text-emerald-400 transition-colors">
              Terms of Service
            </a>
          </li>
          <li>
            <a href="/contact-us" class="text-slate-400 hover:text-emerald-400 transition-colors">
              Contact & Feedback
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Official Government Disclaimer (Crucial for AdSense & PIB Compliance) -->
    <div class="border-t border-slate-800 pt-8 pb-6">
      <div class="bg-slate-950/70 border border-slate-800 rounded-2xl p-4 sm:p-5 text-[11px] sm:text-xs text-slate-400 leading-relaxed">
        <strong class="text-slate-200 block mb-1">⚠️ Important Government Disclaimers & Fair Use Notice:</strong>
