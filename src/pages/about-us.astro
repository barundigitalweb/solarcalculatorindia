---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "About Us - Solar Calculator India | Clean Energy Research";
const description = "Learn about SolarCalculatorIndia.com - an independent clean technology research group providing free, transparent rooftop solar calculation tools.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16">
    <div class="bg-white rounded-3xl p-5 sm:p-10 border border-slate-200 shadow-sm overflow-hidden">
      
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold mb-4">
        <span>🌱 Consumer Advocacy & Clean Tech Initiative</span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 font-display mb-6 tracking-tight break-words">
        About <span class="break-all sm:break-normal">SolarCalculatorIndia.com</span>
      </h1>

      <div class="prose prose-slate max-w-none text-slate-600 space-y-4 text-sm sm:text-base leading-relaxed break-words">
        <p>
          Welcome to <strong>SolarCalculatorIndia.com</strong>. We are an independent, private clean energy research initiative and consumer utility platform founded by renewable energy enthusiasts, data engineers, and green policy advocates in India.
        </p>

        <h3 class="text-lg sm:text-xl font-bold text-slate-900 pt-4">Our Core Mission</h3>
        <p>
          India is undergoing the world's most ambitious clean energy transition, led by landmark initiatives such as the <strong>PM Surya Ghar: Muft Bijli Yojana</strong>. However, the average Indian homeowner often faces confusing technical jargon, opaque installer quotations, and conflicting information regarding state DISCOM tariffs and central subsidies.
        </p>
        <p>
          Our mission is to provide <strong>100% free, mathematically accurate, and completely unbiased rooftop solar feasibility tools</strong>. We empower Indian families to understand:
        </p>
        <ul class="list-disc list-inside space-y-1.5 pl-2">
          <li>Exactly how many kilowatts (kW) of solar panels their rooftop and electricity bill require.</li>
          <li>The exact Central Financial Assistance (CFA) cash subsidy (up to ₹78,000) they are entitled to receive.</li>
          <li>Real monthly energy generation (units) based on localized solar radiation and peak sun hours.</li>
          <li>Realistic capital payback periods and 25-year cumulative financial savings.</li>
        </ul>

        <h3 class="text-lg sm:text-xl font-bold text-slate-900 pt-4">Privacy & Client-Side Architecture</h3>
        <p>
          We believe financial and energy calculation tools should respect user privacy. All simulation algorithms on SolarCalculatorIndia.com execute <strong>100% locally within your web browser (client-side)</strong>. We do not require registration, login, or sensitive personal credentials to access our calculator engine.
        </p>

        <h3 class="text-lg sm:text-xl font-bold text-slate-900 pt-4">Important Non-Governmental Disclaimer</h3>
        <div class="p-4 bg-amber-50 rounded-2xl border border-amber-200 text-amber-950 text-xs sm:text-sm break-words">
          <strong>Notice:</strong> SolarCalculatorIndia.com is an independent consumer research utility and is <strong>NOT affiliated with, sponsored by, or operated by</strong> the Ministry of New and Renewable Energy (MNRE), the Government of India, State Nodal Agencies, or any power distribution utility (DISCOM). The official national portal for government scheme registration is <a href="https://pmsuryaghar.gov.in" target="_blank" rel="noopener noreferrer" class="underline font-bold text-amber-900 break-all sm:break-normal">pmsuryaghar.gov.in</a>.
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
