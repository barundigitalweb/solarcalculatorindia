---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Contact Us - Solar Calculator India | Inquiries & Feedback";
const description = "Contact the SolarCalculatorIndia.com research team for questions, tariff updates, installer partnerships, or technical feedback.";
---

<BaseLayout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    <div class="bg-white rounded-3xl p-5 sm:p-10 border border-slate-200 shadow-sm overflow-hidden">
      
      <div class="text-center mb-8">
        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 font-display mb-2 break-words">
          Contact Our Team
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto">
          Have a question about solar tariffs, want to suggest an updated DISCOM slab, or partner as an MNRE-certified installer? We'd love to hear from you.
        </p>
      </div>

      <div class="max-w-md mx-auto mb-8">
        <div class="p-5 sm:p-8 rounded-3xl bg-emerald-50/80 border border-emerald-200 text-center shadow-xs">
          <div class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-2xl flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <span class="text-[11px] sm:text-xs font-bold text-emerald-800 uppercase tracking-wider block mb-1.5">Official Contact &amp; Support Email</span>
          <a href="mailto:contact@solarcalculatorindia.com" class="text-sm sm:text-base md:text-xl font-bold text-emerald-700 hover:text-emerald-800 underline block mb-2 transition-colors font-display break-all">
            contact@solarcalculatorindia.com
          </a>
          <p class="text-xs text-slate-600 leading-relaxed max-w-xs mx-auto">
            For all general inquiries, DISCOM tariff feedback, technical updates, or verified installer partnerships. Average response within 24–48 hours.
          </p>
        </div>
      </div>

      <div class="p-4 sm:p-5 bg-slate-50 rounded-2xl border border-slate-200 text-xs text-slate-500 leading-relaxed break-words">
        <strong>⚠️ Please Note:</strong> If you have an inquiry regarding an active subsidy application status, pending net-metering inspection, or Direct Benefit Transfer (DBT) payment delay from the Government of India, please contact your local DISCOM nodal officer or call the national PM Surya Ghar toll-free helpline at <strong>15555</strong> / visit <a href="https://pmsuryaghar.gov.in" target="_blank" rel="noopener noreferrer" class="text-emerald-600 underline font-medium">pmsuryaghar.gov.in</a>.
      </div>

    </div>
  </div>
</BaseLayout>
