---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolarCalculator from '../components/SolarCalculator';

const title = "Solar Calculator Delhi 2026 - BSES, TPDDL & Delhi Solar Policy GBI Subsidy";
const description = "Calculate rooftop solar cost and subsidy in Delhi NCR. ₹78,000 PM Surya Ghar subsidy plus ₹3/unit Delhi Solar Policy GBI incentive. BSES Rajdhani, Yamuna, TPDDL net metering.";

const faqs = [
  {
    question: "What is the Generation Based Incentive (GBI) in Delhi?",
    answer: "Under the Delhi Solar Policy 2024, the Delhi Government provides a Generation Based Incentive (GBI) of ₹3.00 per unit for residential rooftop solar for 3 years, directly credited on top of the Central PM Surya Ghar subsidy of up to ₹78,000!"
  },
  {
    question: "Can apartment owners and flats in Delhi install solar?",
    answer: "Yes! Delhi's solar policy allows Virtual Net Metering (VNM) and Group Net Metering (GNM). This permits Resident Welfare Associations (RWAs) and apartment owners to install community solar panels on common terrace space and share energy credits across multiple individual electricity meters."
  },
  {
    question: "How do BSES and Tata Power (TPDDL) net meters work?",
    answer: "BSES and TPDDL replace your standard electric meter with a smart bi-directional net meter. Any solar units produced during peak day hours that you do not consume are exported to the grid, earning you bill credits that offset night-time consumption."
  }
];
---

<BaseLayout title={title} description={description} faqList={faqs}>
  <SolarCalculator 
    client:idle 
    initialStateId="dl"
    pageTitle="Delhi Solar Rooftop Calculator (BSES, TPDDL & Delhi Policy)"
    pageSubtitle="Estimate solar generation, PM Surya Ghar Central subsidy, and ₹3/unit GBI incentive for Delhi, Noida, Gurgaon, Faridabad, and Ghaziabad."
  />

  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-display mb-4">
        Delhi Solar Policy 2024 & PM Surya Ghar Synergy
      </h2>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
        Delhi offers one of the most progressive rooftop solar frameworks in the country. Combining the Central Government's <strong>PM Surya Ghar DBT subsidy (up to ₹78,000)</strong> with the Delhi Government's <strong>₹3/unit Generation Based Incentive (GBI)</strong>, capital breakeven is achieved in under 2.5 years.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-5 rounded-2xl bg-amber-50 border border-amber-200">
          <h4 class="font-bold text-slate-900 text-base mb-2">🎁 ₹3.00 / Unit GBI State Top-Up</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Every unit generated by your rooftop solar plant earns ₹3/unit monthly cash incentives for 3 years, drastically reducing your payback timeline.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200">
          <h4 class="font-bold text-slate-900 text-base mb-2">🏢 Virtual & Group Net Metering</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Apartment dwellers and multi-storey societies in BSES Rajdhani, BSES Yamuna, and TPDDL zones can collectively utilize rooftop space and allocate green credits.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
